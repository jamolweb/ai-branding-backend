generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String?
  googleId     String? @unique
  name         String?
  refreshToken String?

  credits Int @default(0)

  role  Role   @default(USER)
  logos Logo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Logo {
  id       String     @id @default(uuid())
  prompt   String     @db.Text
  imageUrl String
  status   LogoStatus @default(COMPLETED)

  generationTime Int? // Time in ms it took to generate

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // For logo customization
  category String?
  tags     String[] @default([])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("logos")
}

enum LogoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Optional - for tracking generation jobs
model LogoGenerationJob {
  id        String    @id @default(uuid())
  prompt    String    @db.Text
  status    JobStatus @default(PENDING)
  logoId    String?
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  error     String?

  @@map("logo_generation_jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
