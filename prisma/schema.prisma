generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String?
  googleId     String? @unique
  name         String?
  refreshToken String?

  credits Int @default(0)

  role           Role           @default(USER)
  logos          Logo[] // User's created logos
  favoritedLogos FavoriteLogo[] // User's favorited logos

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ChatSession ChatSession[]
  Brandbook   Brandbook[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Logo {
  id       String     @id @default(uuid())
  prompt   String     @db.Text
  imageUrl String
  status   LogoStatus @default(COMPLETED)

  generationTime Int? // Time in ms it took to generate

  // Relations
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  favoritedBy FavoriteLogo[] // Users who favorited this logo

  // For logo customization
  category String?
  tags     String[] @default([])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("logos")
}

enum LogoStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Optional - for tracking generation jobs
model LogoGenerationJob {
  id        String    @id @default(uuid())
  prompt    String    @db.Text
  status    JobStatus @default(PENDING)
  logoId    String?
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  error     String?

  @@map("logo_generation_jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Model for tracking favorited logos
model FavoriteLogo {
  id        String   @id @default(uuid())
  userId    String
  logoId    String
  user      User     @relation(fields: [userId], references: [id])
  logo      Logo     @relation(fields: [logoId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, logoId]) // Prevent duplicate favorites
  @@map("favorite_logos")
}

// Model for chat sessions
model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("chat_sessions")
}

// Model for chat messages
model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id])
  role       MessageRole
  content    String      @db.Text
  tokensUsed Int? // Track token usage for analytics
  createdAt  DateTime    @default(now())

  @@map("chat_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Brandbook {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  companyName String
  tagline     String? // Optional
  industry    String
  description String // Brand description or mission
  authorName  String
  authorRole  String
  authorEmail String

  preferredColor String? // HEX or name
  preferredFont  String? // e.g., "Montserrat"

  logoUrl       String // S3/local URL to uploaded logo
  generatedHtml String // Raw HTML generated by AI
  generatedJson Json? // Optional: structured AI response
  pdfUrl        String? // S3/local path to generated PDF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
